+#ifdef ENET_ADDRESS_CHECK
+/* The value a client writes in the four bytes before the session id: a CRC-32
+   over the address it sends to, as schema/protocol.json gives it. A client
+   does not check what it receives, so this only makes a server's datagrams
+   look like a client's. */
+static void
+enet_protocol_address_check (const ENetAddress * address, enet_uint8 * out)
+{
+    const enet_uint8 * ip = (const enet_uint8 *) & address -> host;
+    enet_uint8 input [10];
+    enet_uint32 reg = 0xFFFFFFFF;
+    size_t i;
+
+    input [0] = ip [0]; input [1] = ip [1]; input [2] = ip [2]; input [3] = ip [3];
+    input [4] = address -> port & 0xFF;
+    input [5] = (address -> port >> 8) & 0xFF;
+    input [6] = 0x98; input [7] = 0x2E; input [8] = 0x3F; input [9] = 0x3C;
+
+    for (i = 0; i < sizeof (input); ++ i)
+    {
+        enet_uint32 entry = (reg >> 24) << 24;
+        int k;
+
+        for (k = 0; k < 8; ++ k)
+          entry = entry & 0x80000000 ? (entry << 1) ^ 0x04C11DB7 : entry << 1;
+        reg = ((reg << 8) | input [i]) ^ entry;
+    }
+
+    reg = ~ reg;
+    out [0] = (reg >> 24) & 0xFF;
+    out [1] = (reg >> 16) & 0xFF;
+    out [2] = (reg >> 8) & 0xFF;
+    out [3] = reg & 0xFF;
+}
+#endif
