{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trueshot:schema:struct",
  "title": "Struct definition",
  "description": "Meta-schema for the reusable field groups in schema/types.",

  "type": "object",
  "required": ["struct", "fields"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "struct": {
      "description": "Stable identity. Matches the file name.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "note": { "$ref": "urn:trueshot:schema:message#/$defs/note" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:trueshot:schema:message#/$defs/field" }
    }
  }
}
