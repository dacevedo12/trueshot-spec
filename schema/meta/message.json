{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trueshot:schema:message",
  "title": "Message definition",
  "description": "Meta-schema for the message definitions in schema/messages.",
  "type": "object",
  "required": ["message", "revisions"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "message": {
      "description": "Stable identity. Never changes once published.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "note": {
      "$ref": "#/$defs/note"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/revision"
      }
    }
  },
  "$defs": {
    "note": {
      "description": "Prose carried as data, so it reaches generated output.",
      "type": "string"
    },
    "version": {
      "description": "Four part client version, as the client reports it.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$"
    },
    "identifier": {
      "description": "A field name. The reserved words are excluded so that a reference to one is never ambiguous.",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$",
      "not": {
        "enum": ["remaining", "terminated"]
      }
    },
    "typeName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "reference": {
      "description": "The name of an earlier field, or a bit within one, written parent.bit.",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)?$",
      "not": {
        "enum": ["remaining", "terminated"]
      }
    },
    "size": {
      "description": "How the reader knows where this field ends: a byte count, the name of an earlier field holding the count, the rest of the payload, or a zero byte.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "string",
          "const": "remaining"
        },
        {
          "type": "string",
          "const": "terminated"
        }
      ]
    },
    "presence": {
      "description": "Present only when an earlier field says so. Without `equals`, any value other than zero.",
      "type": "object",
      "required": ["when"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/reference"
        },
        "equals": {
          "type": "integer"
        }
      }
    },
    "revision": {
      "type": "object",
      "required": ["from", "channel", "command", "direction", "fields"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "First client version this revision applies to. Inclusive.",
          "$ref": "#/$defs/version"
        },
        "until": {
          "description": "Client version it stops applying to. Exclusive. Omit if open ended.",
          "$ref": "#/$defs/version"
        },
        "note": {
          "$ref": "#/$defs/note"
        },
        "channel": {
          "description": "Channel name, defined in schema/channels.json.",
          "type": "string"
        },
        "command": {
          "description": "Value of the leading command byte.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "direction": {
          "type": "string",
          "enum": ["clientToServer", "serverToClient", "bidirectional"]
        },
        "reliability": {
          "description": "Present only where this message differs from its channel default.",
          "type": "string",
          "enum": ["reliable", "unreliable", "unsequenced"]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "unevaluatedProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "note": {
          "$ref": "#/$defs/note"
        },
        "present": {
          "$ref": "#/$defs/presence"
        },
        "type": {
          "type": "string",
          "enum": [
            "u8",
            "u16",
            "u32",
            "u64",
            "i8",
            "i16",
            "i32",
            "i64",
            "f32",
            "f64",
            "bytes",
            "string",
            "array",
            "struct",
            "bits"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "u8",
                  "u16",
                  "u32",
                  "u64",
                  "i8",
                  "i16",
                  "i32",
                  "i64",
                  "f32",
                  "f64"
                ]
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "endian": {
                "description": "Present only where the wire differs from the protocol default.",
                "type": "string",
                "enum": ["little", "big"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bytes"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["size"],
            "properties": {
              "size": {
                "$ref": "#/$defs/size"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["encoding", "size"],
            "properties": {
              "encoding": {
                "type": "string",
                "enum": ["utf8", "ascii"]
              },
              "size": {
                "$ref": "#/$defs/size"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["items"],
            "properties": {
              "count": {
                "description": "A literal count, the name of an earlier field, or repeat to the end.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "#/$defs/reference"
                  },
                  {
                    "type": "string",
                    "const": "remaining"
                  }
                ]
              },
              "items": {
                "$ref": "#/$defs/field"
              },
              "size": {
                "description": "How many bytes the whole run occupies, where a length counts bytes rather than items. Give this or count, not both.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            },
            "oneOf": [
              {
                "required": ["count"],
                "properties": {
                  "count": true
                }
              },
              {
                "required": ["size"],
                "properties": {
                  "size": true
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "struct"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["struct"],
            "properties": {
              "struct": {
                "description": "Name of a definition in schema/types.",
                "$ref": "#/$defs/typeName"
              },
              "size": {
                "description": "How many bytes the struct occupies, where its length is carried on the wire rather than implied by its fields.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bits"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["size", "bits"],
            "properties": {
              "size": {
                "description": "Width of the whole field, in bytes.",
                "type": "integer",
                "minimum": 1
              },
              "bits": {
                "description": "Runs of bits, listed from the least significant upward. Their widths add up to eight times the size.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "width"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/identifier"
                    },
                    "note": {
                      "$ref": "#/$defs/note"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "values": {
                      "$ref": "#/$defs/values"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "values": {
                "$ref": "#/$defs/values"
              }
            }
          }
        }
      ]
    },
    "values": {
      "description": "What the values of this field mean, where a client treats it as a fixed set. A key is the value on the wire, written the way a vector writes it. Recording some of the set does not claim to record all of it.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^-?(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/identifier"
          },
          "note": {
            "$ref": "#/$defs/note"
          }
        }
      }
    }
  }
}
