{
  "$schema": "../meta/message.json",
  "message": "ParticlesCreated",
  "system": "effects",
  "note": "What a server sends to start drawing sets of particles. The header names no object: it carries zero.",
  "revisions": [
    {
      "from": "0.8.13.26",
      "until": "0.9.22.14",
      "channel": "events",
      "command": 21,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "particle",
          "type": "u32",
          "note": "The name this particle answers to, so later messages can name it."
        },
        {
          "name": "flags",
          "type": "u16",
          "note": "Bit 3 set hangs the particle off neither boundTo nor target. Bit 2 set, where boundTo is given, has the particle take its scale from boundTo. Bit 0 sets a further option of the particle's. A server writes the others zero."
        },
        {
          "name": "unknown",
          "type": "bytes",
          "size": 12,
          "note": "Passed to the particle as it is made; what it holds is not recorded."
        },
        {
          "name": "boundTo",
          "type": "u32",
          "note": "The unit the particle hangs off, or zero."
        },
        {
          "name": "effect",
          "type": "string",
          "encoding": "utf8",
          "size": 64,
          "note": "The effect's name. A client fails where it is empty, and still makes a particle for a name it does not know. Written out in full and padded with zero bytes to the width above."
        },
        {
          "name": "unknownB",
          "type": "u32",
          "note": "The point on boundTo the particle hangs from."
        },
        {
          "name": "atX",
          "type": "f32",
          "note": "Where it starts, along one ground axis, in world units; used only where target is zero."
        },
        {
          "name": "atY",
          "type": "f32",
          "note": "Its height."
        },
        {
          "name": "atZ",
          "type": "f32",
          "note": "Along the other ground axis."
        },
        {
          "name": "target",
          "type": "u32",
          "note": "The unit the particle is aimed at, or zero."
        },
        {
          "name": "unknownC",
          "type": "u32",
          "note": "The point on target the particle is aimed at."
        }
      ],
      "note": "One particle, made from its effect's name."
    },
    {
      "from": "0.9.22.14",
      "until": "1.0.0.58",
      "channel": "events",
      "command": 21,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "groupCount",
          "type": "u8",
          "note": "How many sets follow."
        },
        {
          "name": "groups",
          "type": "array",
          "count": "groupCount",
          "note": "The sets themselves.",
          "items": {
            "type": "struct",
            "struct": "ParticleGroup",
            "name": "group"
          }
        }
      ]
    },
