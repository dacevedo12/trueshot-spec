{
  "$schema": "../meta/message.json",
  "message": "WaypointAck",
  "system": "movement",
  "note": "What a client sends once it has taken in a group of movements, naming which group and listing the units the group asked it to relocate. The header names no object: it carries zero.",
  "revisions": [
    {
      "from": "1.0.0.126",
      "until": "1.0.0.127",
      "channel": "requests",
      "command": 122,
      "direction": "clientToServer",
      "reliability": "unsequenced",
      "fields": [
        {
          "name": "syncId",
          "type": "u32",
          "note": "The number of the group it answers."
        },
        {
          "name": "relocationCount",
          "type": "u8",
          "note": "How many of the group's paths carried a teleport token."
        },
        {
          "name": "relocations",
          "type": "array",
          "count": "relocationCount",
          "items": {
            "name": "relocation",
            "type": "record",
            "fields": [
              {
                "name": "unit",
                "type": "u32",
                "note": "The unit."
              },
              {
                "name": "token",
                "type": "u8",
                "note": "The token its path carried."
              }
            ]
          },
          "note": "Each of those, in the group's order."
        }
      ],
      "note": "What a client sends for every WaypointGroup it takes. The header names no object: it carries zero."
