{
  "$schema": "../meta/message.json",
  "message": "EffectReplacedGroup",
  "note": "What a server sends to replace one effect with another on several units at once. The header names no object it acts on: the units are listed below.",
  "revisions": [
    {
      "from": "4.17.0.233",
      "until": "4.18.0.0",
      "channel": "events",
      "command": 30,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "runningFor",
          "type": "f32",
          "note": "How long the effect has already run, in seconds."
        },
        {
          "name": "lasts",
          "type": "f32",
          "note": "How long it runs in total, in seconds."
        },
        {
          "name": "count",
          "type": "u8",
          "note": "How many units follow."
        },
        {
          "name": "entries",
          "type": "array",
          "count": "count",
          "items": {
            "name": "entriesEntry",
            "type": "record",
            "fields": [
              {
                "name": "unit",
                "type": "u32",
                "note": "The unit carrying the effect."
              },
              {
                "name": "caster",
                "type": "u32",
                "note": "The unit that put it there."
              },
              {
                "name": "slot",
                "type": "u8",
                "note": "Which of the unit's effect slots."
              }
            ]
          },
          "note": "The units, one place each."
        }
      ]
    }
  ]
}
