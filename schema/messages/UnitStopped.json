      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "x",
          "type": "f32",
          "note": "Where the unit stands; a client keeps this height rather than the ground's."
        },
        {
          "name": "y",
          "type": "f32",
          "note": "Its height."
        },
        {
          "name": "z",
          "type": "f32",
          "note": "Where it stands."
        },
        {
          "name": "facingX",
          "type": "f32",
          "note": "The way it faces."
        },
        {
          "name": "facingY",
          "type": "f32",
          "note": "The way it faces."
        },
        {
          "name": "facingZ",
          "type": "f32",
          "note": "The way it faces."
        },
        {
          "name": "syncId",
          "type": "i32",
          "note": "The unit's movement count."
        }
      ]
    }
  ]
}
