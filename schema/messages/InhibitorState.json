{
  "$schema": "../meta/message.json",
  "message": "InhibitorState",
  "system": "combat",
  "note": "What a server sends to change the state of an inhibitor, and say how long the new state lasts. The header names the unit this is about.",
  "revisions": [
    {
      "from": "1.0.0.113",
      "until": "1.0.0.122",
      "channel": "events",
      "command": 44,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "state",
          "type": "u32",
          "note": "What state the inhibitor takes. A client ignores any other value.",
          "values": {
            "0": {
              "name": "down",
              "note": "The inhibitor is down for duration."
            },
            "1": {
              "name": "restored",
              "note": "The inhibitor stands again."
            }
          }
        },
        {
          "name": "duration",
          "type": "u32",
          "note": "How long the state lasts, in seconds."
        }
      ]
    },
