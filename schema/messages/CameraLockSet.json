{
  "$schema": "../meta/message.json",
  "message": "CameraLockSet",
  "system": "interface",
  "note": "What a server sends to lock the camera to the champion or free it. A client answers with CameraLock, except while playing a replay, and ignores the message while something of its own holds the camera. The header carries zero.",
  "revisions": [
    {
      "from": "4.17.0.233",
      "until": "4.18.0.0",
      "channel": "events",
      "command": 120,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "state",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "locked",
              "width": 1,
              "note": "Set to lock the camera, clear to free it."
            },
            {
              "name": "unused",
              "width": 7,
              "note": "Unused; a server writes zero."
            }
          ],
          "note": "Whether the camera is locked."
        }
      ]
    },
    {
