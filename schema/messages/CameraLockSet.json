{
  "$schema": "../meta/message.json",
  "message": "CameraLockSet",
  "system": "interface",
  "note": "What a server sends to lock the camera to the champion or free it. A client answers with CameraLock, except while playing a replay, and ignores the message while something of its own holds the camera. The header carries zero.",
  "revisions": [
    {
      "from": "1.0.0.126",
      "until": "1.0.0.127",
      "note": "A client answers at once with CameraLock, returning the state byte as it arrived.",
      "channel": "events",
      "command": 124,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "state",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "locked",
              "width": 1,
              "note": "Set to lock the camera, clear to free it."
            },
            {
              "name": "unused",
              "width": 7,
              "note": "A server writes zero. A client keeps these bits with the rest of the byte and returns them in CameraLock; what else they do is not recorded."
            }
          ],
          "note": "Whether the camera is locked."
        }
      ]
    },
    {
      "from": "1.0.0.134",
