{
  "$schema": "../meta/message.json",
  "message": "ScoreAdded",
  "system": "replication",
  "note": "What a server sends to add to a player's score. The header carries zero.",
  "revisions": [
    {
      "from": "1.0.0.126",
      "until": "1.0.0.127",
      "channel": "events",
      "command": 226,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "champion",
          "type": "u32",
          "note": "The champion whose score it is."
        },
        {
          "name": "category",
          "type": "u8",
          "note": "Which part of the score.",
          "values": {
            "0": {
              "name": "offense"
            },
            "1": {
              "name": "defense"
            },
            "2": {
              "name": "combat"
            },
            "3": {
              "name": "objective"
            }
          }
        },
        {
          "name": "event",
          "type": "u8",
          "note": "What earned it."
        },
        {
          "name": "flags",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "callout",
              "width": 1,
              "note": "Set where the client announces it."
            },
            {
              "name": "unused",
              "width": 7,
              "note": "A client ignores these; a server writes zero."
            }
          ],
          "note": "How it is shown."
        },
        {
          "name": "points",
          "type": "f32",
          "note": "How much is added."
        }
      ],
      "note": "A client ignores the message where champion names no champion it holds."
    },
