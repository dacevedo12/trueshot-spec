{
  "$schema": "../meta/message.json",
  "message": "SeatChampion",
  "system": "joining",
  "note": "What a server sends to say which champion a seat is playing, while the match is being put together.",
  "revisions": [
    {
      "from": "1.0.0.126",
      "until": "1.0.0.127",
      "channel": "roster",
      "command": 101,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "leading",
          "type": "bytes",
          "size": 7,
          "note": "Unused; a server writes zero."
        },
        {
          "name": "player",
          "type": "i64",
          "note": "Whose champion this is."
        },
        {
          "name": "skin",
          "type": "u32",
          "note": "Which look it wears."
        },
        {
          "name": "between",
          "type": "bytes",
          "size": 4,
          "note": "What this carries is not recorded."
        },
        {
          "name": "asset",
          "type": "string",
          "size": "terminated",
          "encoding": "utf8",
          "note": "The champion the seat plays."
        }
      ]
    },
    {
      "from": "1.0.0.152",
      "until": "4.21.0.0",
      "channel": "roster",
      "command": 101,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "player",
          "type": "i64",
          "note": "The player this is about. It has a player identifier's width."
        },
        {
          "name": "skin",
          "type": "i32",
          "note": "Which look the champion wears."
        },
        {
          "name": "assetLength",
          "type": "u32",
          "note": "How many bytes the name below occupies, counting the byte that ends it."
        },
        {
          "name": "asset",
          "type": "string",
          "encoding": "utf8",
          "size": {
            "field": "assetLength",
            "minus": 1
          },
          "note": "The name the client loads the champion's art and sound under. It is not padded."
        },
        {
          "name": "terminator",
          "type": "bytes",
          "size": 1,
          "note": "A zero byte closing the text, which the length above counts."
        }
      ]
    }
  ]
}
