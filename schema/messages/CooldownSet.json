            {
              "name": "summonerSpell",
              "width": 1,
              "note": "Set where the slot belongs to the second spell book, whatever its number."
            }
          ]
        },
        {
          "name": "cooldown",
          "type": "f32",
          "note": "The cooldown set, in seconds."
        }
