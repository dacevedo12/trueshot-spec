{
  "$schema": "../meta/message.json",
  "message": "CooldownSet",
  "system": "spells",
  "note": "What a client sends where a script of its own sets a spell slot's cooldown. The header names the unit.",
  "revisions": [
    {
      "from": "0.8.13.26",
      "until": "0.9.22.14",
      "channel": "requests",
      "command": 33,
      "direction": "clientToServer",
      "reliability": "reliable",
      "fields": [
        {
          "name": "token",
          "type": "u32",
          "note": "Names this report: its low 24 bits count up by one with each numbered request the client sends, of any kind, and its high 8 bits hold the byte below."
        },
        {
          "name": "clientByte",
          "type": "u8",
          "note": "A byte of the client's own, as in token."
        },
        {
          "name": "which",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "slot",
              "width": 7,
              "note": "Which slot, 0 to 22."
            },
            {
              "name": "summonerSpell",
              "width": 1,
              "note": "Set where a script names the unit's second set of spells."
            }
          ]
        },
        {
          "name": "cooldown",
          "type": "f32",
          "note": "The cooldown set, in seconds."
        }
      ]
    },
