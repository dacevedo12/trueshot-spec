{
  "$schema": "../meta/message.json",
  "message": "ChampionDied",
  "system": "combat",
  "note": "What a server sends to say a champion died. The header names the unit this is about.",
  "revisions": [
    {
      "from": "1.0.0.126",
      "until": "1.0.0.127",
      "channel": "events",
      "command": 97,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "killer",
          "type": "u32",
          "note": "The unit credited with the death. Where it names the champion that died, a client still plays the death."
        },
        {
          "name": "unused",
          "type": "u16",
          "note": "Unused; a server writes zero."
        },
        {
          "name": "stayDown",
          "type": "f32",
          "note": "How long the champion stays down, in seconds. A client counts its respawn timer down from it."
        },
        {
          "name": "zombie",
          "type": "u8",
          "note": "Any value other than zero leaves the champion standing in a zombie state rather than dead, with no death animation."
        }
      ]
    },
