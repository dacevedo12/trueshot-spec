{
  "$schema": "../meta/message.json",
  "message": "DeathHistory",
  "note": "What a server sends to say what led to a death, so the client can lay it out.",
  "revisions": [
    {
      "from": "4.20.0.315",
      "channel": "events",
      "command": 33,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "cause",
          "type": "u8",
          "note": "What sort of thing did it."
        },
        {
          "name": "killer",
          "type": "u32",
          "note": "The unit credited with it."
        },
        {
          "name": "stayDown",
          "type": "f32",
          "note": "How long the unit stays down, in seconds."
        },
        {
          "name": "entryCount",
          "type": "u32",
          "note": "How many entries follow."
        },
        {
          "name": "entries",
          "type": "array",
          "count": "entryCount",
          "note": "What led to the death, oldest last.",
          "items": {
            "name": "entry",
            "type": "struct",
            "struct": "DeathEvent"
          }
        }
      ]
    }
  ]
}
