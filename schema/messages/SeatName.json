{
  "$schema": "../meta/message.json",
  "message": "SeatName",
  "system": "joining",
  "note": "What a server sends to say what a seat is called, while the match is being put together.",
  "revisions": [
    {
      "from": "1.0.0.126",
      "until": "1.0.0.127",
      "channel": "roster",
      "command": 102,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "leading",
          "type": "bytes",
          "size": 7,
          "note": "Unused; a server writes zero."
        },
        {
          "name": "player",
          "type": "i64",
          "note": "Whose name this is."
        },
        {
          "name": "between",
          "type": "bytes",
          "size": 8,
          "note": "What this carries is not recorded."
        },
        {
          "name": "name",
          "type": "string",
          "size": "terminated",
          "encoding": "utf8",
          "note": "What the seat is called."
        }
      ]
    },
    {
      "from": "1.0.0.151",
      "until": "4.21.0.0",
      "channel": "roster",
      "command": 102,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "player",
          "type": "i64",
          "note": "The player this is about. It has a player identifier's width."
        },
        {
          "name": "skin",
          "type": "i32",
          "note": "Which look the seat's champion wears."
        },
        {
          "name": "nameLength",
          "type": "u32",
          "note": "How many bytes the name below occupies, counting the byte that ends it."
        },
        {
          "name": "name",
          "type": "string",
          "encoding": "utf8",
          "size": {
            "field": "nameLength",
            "minus": 1
          },
          "note": "What the seat is called. It is not padded."
        },
        {
          "name": "terminator",
          "type": "bytes",
          "size": 1,
          "note": "A zero byte closing the text, which the length above counts."
        }
      ]
    }
  ]
}
