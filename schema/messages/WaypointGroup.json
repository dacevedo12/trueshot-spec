{
  "$schema": "../meta/message.json",
  "message": "WaypointGroup",
  "system": "movement",
  "note": "What a server sends to move units. It carries a number a client returns to say it has taken the group in. The header carries zero or names the object this is about, and a client accepts either.",
  "revisions": [
    {
      "from": "1.0.0.126",
      "until": "1.0.0.127",
      "channel": "events",
      "command": 100,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "syncId",
          "type": "u32",
          "note": "The number of this statement; a client applies a path to a unit only where it is not behind the last the unit took."
        },
        {
          "name": "movementCount",
          "type": "u16",
          "note": "How many paths follow. A count above 32767 counts as none, as zero does, and a client still answers."
        },
        {
          "name": "movements",
          "type": "array",
          "count": "movementCount",
          "items": {
            "name": "movement",
            "type": "record",
            "fields": [
              {
                "name": "header",
                "type": "bits",
                "size": 4,
                "bits": [
                  {
                    "name": "hasTeleportToken",
                    "width": 1,
                    "note": "Set where a teleport token follows the unit."
                  },
                  {
                    "name": "unused",
                    "width": 15,
                    "note": "Carries nothing."
                  },
                  {
                    "name": "pointCount",
                    "width": 7,
                    "note": "How many points the path has, from 1 to 127. A group whose entry gives 0 ends there."
                  },
                  {
                    "name": "unusedHigh",
                    "width": 9,
                    "note": "Carries nothing."
                  }
                ]
              },
              {
                "name": "unit",
                "type": "u32",
                "note": "The unit the path is for. Where a client does not hold it, the movements after it in the group go wrong too; a server sends only units the client holds."
              },
              {
                "name": "teleportToken",
                "type": "u8",
                "present": {
                  "when": "header.hasTeleportToken"
                },
                "note": "Where it differs from the one the unit holds, the unit is put at the first point rather than walking there."
              },
              {
                "name": "flags",
                "type": "bitArray",
                "count": {
                  "field": "header.pointCount",
                  "minus": 1
                },
                "bits": [
                  {
                    "name": "xIsStep",
                    "width": 1
                  },
                  {
                    "name": "zIsStep",
                    "width": 1
                  }
                ],
                "note": "Whether each coordinate of the points after the first is a step from the point before it."
              },
              {
                "name": "firstX",
                "type": "i16",
                "note": "The first point, along one ground axis, in the map's path coordinates."
              },
              {
                "name": "firstZ",
                "type": "i16",
                "note": "Along the other ground axis."
              },
              {
                "name": "steps",
                "type": "array",
                "count": {
                  "field": "header.pointCount",
                  "minus": 1
                },
                "items": {
                  "name": "step",
                  "type": "record",
                  "fields": [
                    {
                      "name": "xStep",
                      "type": "i8",
                      "present": {
                        "when": "flags[step].xIsStep"
                      },
                      "note": "A step from the point before, along one axis."
                    },
                    {
                      "name": "xWhole",
                      "type": "i16",
                      "present": {
                        "when": "flags[step].xIsStep",
                        "equals": 0
                      },
                      "note": "The coordinate afresh."
                    },
                    {
                      "name": "zStep",
                      "type": "i8",
                      "present": {
                        "when": "flags[step].zIsStep"
                      },
                      "note": "A step along the other axis."
                    },
                    {
                      "name": "zWhole",
                      "type": "i16",
                      "present": {
                        "when": "flags[step].zIsStep",
                        "equals": 0
                      },
                      "note": "The coordinate afresh."
                    }
                  ]
                },
                "note": "Every point after the first."
              }
            ]
          },
          "note": "One path for each unit."
        }
      ],
      "note": "What a server sends to set units walking paths, which each walks at its own speed."
    },
    {
      "from": "3.01.0.1",
      "until": "4.11.0.386",
      "channel": "transient",
      "command": 96,
      "direction": "serverToClient",
      "reliability": "unreliable",
      "fields": [
        {
          "name": "syncId",
          "type": "u32",
          "note": "Names this group. A client returns it to say the group arrived."
        },
        {
          "name": "movementCount",
          "type": "u16",
          "note": "How many units the group moves."
        },
        {
          "name": "movements",
          "type": "array",
          "count": "movementCount",
          "items": {
            "name": "movement",
            "type": "struct",
            "struct": "Movement"
          }
        }
      ]
    },
    {
      "from": "4.11.0.386",
      "until": "4.21.0.0",
      "channel": "transient",
      "command": 97,
      "direction": "serverToClient",
      "reliability": "unreliable",
      "fields": [
        {
          "name": "syncId",
          "type": "u32",
          "note": "Names this group. A client returns it to say the group arrived."
        },
        {
          "name": "movementCount",
          "type": "u16",
          "note": "How many units the group moves."
        },
        {
          "name": "movements",
          "type": "array",
          "count": "movementCount",
          "items": {
            "name": "movement",
            "type": "struct",
            "struct": "Movement"
          }
        }
      ]
    }
  ]
}
