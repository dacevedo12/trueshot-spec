{
  "$schema": "../meta/message.json",
  "message": "SpellSlotChanged",
  "system": "spells",
  "note": "What a server sends to change one thing about a spell already in a unit's slot. The kind settles what follows it. The header names the unit this is about.",
  "revisions": [
    {
      "from": "4.1.0.171",
      "until": "4.18.0.271",
      "channel": "events",
      "command": 23,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "which",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "slot",
              "width": 6,
              "note": "Which slot. A champion's own spells count from 0."
            },
            {
              "name": "summonerSlots",
              "width": 1,
              "note": "Set where slot names a summoner spell's slot, clear for the unit's own spells; every kind obeys it."
            },
            {
              "name": "unused",
              "width": 1,
              "note": "Unused; a server writes zero."
            }
          ]
        },
        {
          "name": "kind",
          "type": "u8",
          "note": "What changes. A client does nothing for any other value.",
          "values": {
            "0": {
              "name": "targeting",
              "note": "Sets how the spell is aimed; one byte follows."
            },
            "1": {
              "name": "name"
            },
            "2": {
              "name": "range",
              "note": "Sets how far it is cast; a float follows."
            },
            "3": {
              "name": "maxRange",
              "note": "Sets the farthest its range can grow to; a float follows."
            },
            "4": {
              "name": "shownRange",
              "note": "Sets the range its indicator shows; a float follows."
            },
            "5": {
              "name": "icon",
              "note": "Sets which icon it shows; one byte follows."
            },
            "6": {
              "name": "offsetTargets",
              "note": "Sets the units it is cast from; a count and that many units follow."
            }
          }
        },
        {
          "name": "name",
          "type": "string",
          "encoding": "utf8",
          "size": "terminated",
          "note": "The name the client loads the spell under, ended by a zero byte. A client shows the named spell's icon in the slot.",
          "present": {
            "when": "kind",
            "equals": 1
          }
        },
        {
          "name": "targeting",
          "type": "u8",
          "present": {
            "when": "kind",
            "equals": 0
          },
          "note": "How the spell is aimed."
        },
        {
          "name": "range",
          "type": "f32",
          "present": {
            "when": "kind",
            "equals": 2
          },
          "note": "How far the spell is cast, in world units."
        },
        {
          "name": "maxRange",
          "type": "f32",
          "present": {
            "when": "kind",
            "equals": 3
          },
          "note": "The farthest the spell's cast range can grow to, in world units."
        },
        {
          "name": "shownRange",
          "type": "f32",
          "present": {
            "when": "kind",
            "equals": 4
          },
          "note": "The range its range indicator shows, in world units."
        },
        {
          "name": "icon",
          "type": "u8",
          "present": {
            "when": "kind",
            "equals": 5
          },
          "note": "Which icon the spell shows."
        },
        {
          "name": "targetCount",
          "type": "u8",
          "present": {
            "when": "kind",
            "equals": 6
          },
          "note": "How many units follow."
        },
        {
          "name": "targets",
          "type": "array",
          "count": "targetCount",
          "present": {
            "when": "kind",
            "equals": 6
          },
          "note": "The units the spell is cast from.",
          "items": {
            "name": "target",
            "type": "u32",
            "note": "One unit."
          }
        }
      ]
    },
    {
      "from": "4.20.0.315",
      "until": "4.21.0.0",
      "channel": "events",
      "command": 23,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "slot",
          "type": "u8",
          "note": "Which slot. A champion's own spells count from 0."
        },
        {
          "name": "what",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "summonerSpell",
              "width": 1,
              "note": "Set where the slot is a summoner slot rather than one of the unit's own."
            },
            {
              "name": "unused",
              "width": 7,
              "note": "Unused; a server writes zero."
            }
          ]
        },
        {
          "name": "kind",
          "type": "u32",
          "note": "What changes, and so which shape follows.",
          "values": {
            "1": {
              "name": "targeting"
            },
            "2": {
              "name": "name"
            },
            "3": {
              "name": "range"
            },
            "4": {
              "name": "maxRange"
            },
            "5": {
              "name": "shownRange"
            },
            "6": {
              "name": "icon"
            },
            "7": {
              "name": "targets"
            }
          }
        },
        {
          "name": "targeting",
          "type": "u8",
          "note": "How the spell is aimed.",
          "present": {
            "when": "kind",
            "equals": 1
          }
        },
        {
          "name": "name",
          "type": "string",
          "encoding": "utf8",
          "size": "terminated",
          "note": "The name the client loads the spell under, ended by a zero byte. A client shows the named spell's icon in the slot.",
          "present": {
            "when": "kind",
            "equals": 2
          }
        },
        {
          "name": "range",
          "type": "f32",
          "note": "How far the spell is cast, in world units.",
          "present": {
            "when": "kind",
            "equals": 3,
            "unseen": "present"
          }
        },
        {
          "name": "maxRange",
          "type": "f32",
          "note": "The farthest the spell's cast range can grow to, in world units.",
          "present": {
            "when": "kind",
            "equals": 4,
            "unseen": "present"
          }
        },
        {
          "name": "shownRange",
          "type": "f32",
          "note": "The range its range indicator shows, in world units.",
          "present": {
            "when": "kind",
            "equals": 5,
            "unseen": "present"
          }
        },
        {
          "name": "icon",
          "type": "u8",
          "note": "Which icon the spell shows.",
          "present": {
            "when": "kind",
            "equals": 6,
            "unseen": "present"
          }
        },
        {
          "name": "targetCount",
          "type": "u8",
          "note": "How many units follow.",
          "present": {
            "when": "kind",
            "equals": 7,
            "unseen": "present"
          }
        },
        {
          "name": "targets",
          "type": "array",
          "count": "targetCount",
          "items": {
            "name": "target",
            "type": "u32",
            "note": "A unit the spell is cast from."
          },
          "note": "The units the spell is cast from.",
          "present": {
            "when": "kind",
            "equals": 7,
            "unseen": "present"
          }
        }
      ]
    }
  ]
}
