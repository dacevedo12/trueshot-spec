{
  "$schema": "../meta/message.json",
  "message": "ItemAdded",
  "note": "What a server sends to say an item reached a slot. It follows a request to buy one, and is also sent where nothing asked for it.",
  "revisions": [
    {
      "from": "4.20.0.315",
      "channel": "events",
      "command": 111,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "item",
          "type": "u32",
          "note": "Which item, by the number the client knows it as."
        },
        {
          "name": "slot",
          "type": "u8",
          "note": "The slot it went to."
        },
        {
          "name": "inSlot",
          "type": "u8",
          "note": "How many of it are in that slot now."
        },
        {
          "name": "charges",
          "type": "u8",
          "note": "How many uses it carries."
        },
        {
          "name": "how",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "tellTheClient",
              "width": 1,
              "note": "Purpose undetermined. Clear in everything observed."
            },
            {
              "name": "unknown",
              "width": 7,
              "note": "Observed clear."
            }
          ]
        }
      ]
    }
  ]
}
