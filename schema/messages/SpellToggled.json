{
  "$schema": "../meta/message.json",
  "message": "SpellToggled",
  "system": "spells",
  "note": "What a server sends to turn one of a unit's spells on or off. The header names the unit this is about.",
  "revisions": [
    {
      "from": "4.1.0.171",
      "until": "4.18.0.271",
      "channel": "events",
      "command": 280,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "slot",
          "type": "u32",
          "note": "Which of the champion's own spells, 0 to 62; a client ignores any other value. Summoner spells are never toggled by it."
        },
        {
          "name": "state",
          "type": "u8",
          "note": "Nonzero to toggle the spell on, zero off."
        }
      ]
    },
    {
      "from": "4.18.0.271",
      "until": "4.21.0.0",
      "channel": "events",
      "command": 280,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "slot",
          "type": "u32",
          "note": "Which slot."
        },
        {
          "name": "state",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "on",
              "width": 1,
              "note": "Set where the spell is now on."
            },
            {
              "name": "unused",
              "width": 7,
              "note": "Unused; a server writes zero."
            }
          ]
        }
      ]
    }
  ]
}
