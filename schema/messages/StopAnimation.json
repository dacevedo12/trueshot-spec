          "size": 1,
          "bits": [
            {
              "name": "fade",
              "width": 1,
              "note": "Set where the animation fades out."
            },
            {
              "name": "ignoreLock",
              "width": 1,
              "note": "Set where a lock on the animation is ignored."
            },
            {
              "name": "stopAll",
              "width": 1,
              "note": "Set where every animation stops when the name below is empty."
            },
            {
              "name": "unused",
              "width": 5,
              "note": "Unused; a server writes zero."
            }
