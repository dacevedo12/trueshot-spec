{
  "$schema": "../meta/message.json",
  "message": "MissileHits",
  "system": "spells",
  "note": "What a server sends to say which units a missile struck. The header names the missile.",
  "revisions": [
    {
      "from": "1.0.0.126",
      "until": "1.0.0.127",
      "channel": "events",
      "command": 40,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "count",
          "type": "u16",
          "note": "How many units follow. A count of zero or above 32767 carries no units, so a server sends at most 32767."
        },
        {
          "name": "targets",
          "type": "array",
          "count": "count",
          "items": {
            "name": "target",
            "type": "u32",
            "note": "A unit struck."
          },
          "note": "The units struck, in order. A client still takes a unit it does not know, with nothing shown on it, and nothing after the hit that destroys the missile shows."
        }
      ]
    },
