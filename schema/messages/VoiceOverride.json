{
  "$schema": "../meta/message.json",
  "message": "VoiceOverride",
  "system": "effects",
  "note": "What a server sends to change or reset the voice a unit speaks with. The header names the unit.",
  "revisions": [
    {
      "from": "4.10.0.379",
      "until": "4.11.0.386",
      "channel": "events",
      "command": 149,
      "direction": "serverToClient",
      "reliability": "reliable",
      "fields": [
        {
          "name": "flags",
          "type": "bits",
          "size": 1,
          "bits": [
            {
              "name": "reset",
              "width": 1,
              "note": "Set where the unit returns to its own voice; no name follows."
            },
            {
              "name": "unused",
              "width": 7,
              "note": "Unused; a server writes zero."
            }
          ],
          "note": "Whether to reset."
        },
        {
          "name": "voice",
          "type": "string",
          "encoding": "utf8",
          "size": "terminated",
          "note": "The voice's name, ended by a zero byte.",
          "present": {
            "when": "flags.reset",
            "equals": 0
          }
        },
        {
          "name": "leftover",
          "type": "u8",
          "present": {
            "when": "flags.reset",
            "equals": 1
          },
          "note": "One byte where no name follows. Unused; its byte carries no meaning."
        }
      ]
    },
