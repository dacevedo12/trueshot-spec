            },
            "32": {
              "name": "chat"
            },
            "64": {
              "name": "minimapMovement",
              "note": "Moving by the minimap."
            },
            "128": {
              "name": "cameraMovement"
            }
          }
        }
      ],
      "note": "A client acts on the change at once only where locks is 1, 4, 8, 16, 32 or 128; any other value still changes what is locked, and takes effect as the player next tries."
