{
  "name": "trueshot-spec-tools",
  "private": true,
  "description": "Checks for the specification. Not published, and not needed to implement from the spec.",
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{json,md,ts}\"",
    "site": "bun scripts/site.ts",
    "range": "bun scripts/range.ts",
    "check": "bun run check:names && bun run check:format && bun run check:types && bun run check:codec && bun run check:schema && bun run check:book && bun run check:prose && bun run check:links",
    "check:names": "ls-lint",
    "check:format": "prettier --check \"**/*.{json,md,ts}\"",
    "check:types": "tsc --noEmit",
    "check:codec": "bun test ./scripts",
    "check:schema": "bun scripts/validate.ts",
    "check:book": "bun scripts/book.ts --check",
    "check:prose": "vale --glob='!{dist,node_modules}/**' .",
    "check:links": "lychee --no-progress --require-https=false --exclude-path dist .",
    "live:native": "conformance/live/native/build.sh",
    "live:checks": "bun test ./conformance/live/checks --timeout 600000",
    "live:conform": "bun conformance/live/src/conform.ts",
    "live:replay": "bun conformance/live/src/replay.ts",
    "live:serve": "bun conformance/live/src/serve.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.3",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/bun": "1.4.3",
    "ajv": "8.20.0",
    "enet-js": "1.2.8",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
